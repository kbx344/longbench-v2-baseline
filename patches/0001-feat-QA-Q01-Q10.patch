new file mode 100644
index 0000000..0d0e216
--- /dev/null
+++ b/core-flow/src/main/java/com/horsecoder/common/whuTalent/core/flow/QA/code/FlowCodeQaStreamRead.java
@@ -0,0 +1,106 @@
+package com.horsecoder.common.whuTalent.core.flow.QA.code;
+
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import cc.eamon.open.flow.spring.FlowComponent;
+import com.fasterxml.jackson.databind.JsonNode;
+
+/**
+ * 顺序逐段读完整份材料，只维护一份滚动笔记
+ *
+ * FLOW_QA_STREAM_READ
+ *
+ * 不带任何检索、定位、统计逻辑：第 i 段读进来，与已有笔记合并，输出新笔记，
+ * 交给第 i+1 段。读完最后一段时，笔记就是"人把这堆材料从头看到尾会记住的东西"。
+ *
+ * 与 Q02 的 FLOW_QA_SUMMARIZE 的区别：那个是逐份文档各出摘要、互不相干；
+ * 这个是全篇一条线，后面的段落能看到前面留了什么。
+ *
+ * @param segments 顺序分段
+ * @param question 题干
+ * @param choices 选项
+ * @result memo 滚动笔记
+ * @result segCount 实际读过的段数
+ */
+@FlowComponent
+public class FlowCodeQaStreamRead {
+
+    /** 连续这么多段笔记没有变化，就认为后面的段落都是噪声，提前收尾 */
+    private static final int IDLE_LIMIT = 3;
+
+    private static final String READ_SYS =
+            "你在逐段阅读一份长材料，目标是回答用户给出的选择题。"
+            + "每收到一段，只做两件事：摘出与选项直接相关的原文（原样引用，每处不超过三行），"
+            + "并把它并进已有笔记；然后输出更新后的完整笔记，不超过 800 字。"
+            + "笔记只写事实和原文引用，不写评价、不下结论、不猜选项。"
+            + "若材料是表格或数值序列、题目要求比较或统计，就按题目的口径逐段计算本段的结果"
+            + "（时间或行标识 + 数值），与笔记里已有的最优比较后只留更优的那一条，不要罗列整段数据。"
+            + "本段确实没有相关内容时，原样输出已有笔记，不要为了填满而补充。";
+
+    @Flow("FLOW_QA_STREAM_READ")
+    public void flowCodeQaStreamRead(
+            String segments,
+            String question,
+            String choices,
+            String idleLimit
+    ) {
+        String memo = "（空）";
+        int readCount = 0;
+        String segInfo = "";
+        int idleGate = IDLE_LIMIT;
+        try {
+            if (idleLimit != null && !idleLimit.trim().isEmpty()) {
+                idleGate = Integer.parseInt(idleLimit.trim());
+            }
+        } catch (Exception ignored) {
+            idleGate = IDLE_LIMIT;
+        }
+        try {
+            JsonNode segs = QaSupport.JSON.readTree(segments == null ? "[]" : segments);
+            int total = segs.size();
+            int idle = 0;
+            String prev = null;
+            for (JsonNode s : segs) {
+                readCount++;
+                memo = readOne(memo, question, choices, s.path("text").asText(""), readCount, total);
+                if (prev != null && prev.equals(memo)) {
+                    idle++;
+                } else {
+                    idle = 0;
+                }
+                prev = memo;
+                if (idleGate > 0 && idle >= idleGate) {
+                    break;
+                }
+            }
+            segInfo = readCount + "/" + total;
+        } catch (Exception e) {
+            memo = "[STREAM_FAILED] " + e.toString();
+        }
+        FlowEngine.instance().register("memo", memo);
+        FlowEngine.instance().register("segCount", String.valueOf(readCount));
+        FlowEngine.instance().register("segInfo", segInfo);
+    }
+
+    private String readOne(String memo, String question, String choices,
+                           String body, int idx, int total) {
+        String user = "题目：\n" + question + "\n\n四个选项：\n" + choices
+                + "\n\n已有笔记：\n" + memo
+                + "\n\n本段是第 " + idx + "/" + total + " 段，正文如下：\n" + body;
+        for (int attempt = 1; attempt <= 3; attempt++) {
+            try {
+                return QaSupport.callLlm(READ_SYS, user, 2000).trim();
+            } catch (Exception e) {
+                if (attempt == 3) {
+                    return memo;
+                }
+                try {
+                    Thread.sleep(6000L * attempt);
+                } catch (InterruptedException ignored) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+        }
+        return memo;
+    }
+}
diff --git a/core-flow/src/main/java/com/horsecoder/common/whuTalent/core/flow/QA/code/FlowCodeQaSummarize.java b/core-flow/src/main/java/com/horsecoder/common/whuTalent/core/flow/QA/code/FlowCodeQaSummarize.java
new file mode 100644
index 0000000..f0b708c
--- /dev/null
+++ b/core-flow/src/main/java/com/horsecoder/common/whuTalent/core/flow/QA/code/FlowCodeQaSummarize.java
@@ -0,0 +1,110 @@
+package com.horsecoder.common.whuTalent.core.flow.QA.code;
+
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import cc.eamon.open.flow.spring.FlowComponent;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.node.ArrayNode;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+
+/**
+ * 逐份文档做结构化摘要
+ *
+ * FLOW_QA_SUMMARIZE
+ *
+ * 一份文档单独可能仍会超过网关的处理时间，所以内部按 15 万字符再切块，
+ * 逐块摘要后按块拼回，一块也不丢。这一步是"分段摘要"真正落地的地方。
+ *
+ * @param segments 分段结果
+ * @result bookSummaries 每份文档的摘要（JSON 数组）
+ * @result digest 合成后的摘要正文
+ */
+@FlowComponent
+public class FlowCodeQaSummarize {
+
+    /** 单次送进网关的字符上限：实测 15 万字符以内不触发网关超时 */
+    private static final int CHUNK = 150_000;
+
+    private static final String SUMSYS =
+            "你在做文献分段摘要。只摘你看到的这部分内容，输出中文，不超过 700 字。"
+            + "必须覆盖四项：1) 出现的章/节标题及其主题；2) 是否涉及特别观察专章及讲什么；"
+            + "3) 司法审查、仲裁协议、争端解决机制方面的具体进展或新规定；"
+            + "4) 案件数量与标的额数据（有就写，没有就写无）。"
+            + "只写原文确实有的内容，不要推测、不要补全。";
+
+    @Flow("FLOW_QA_SUMMARIZE")
+    public void flowCodeQaSummarize(
+            String segments
+    ) {
+        String bookSummaries = "[]";
+        String digest = "";
+        try {
+            JsonNode segs = QaSupport.JSON.readTree(segments == null ? "[]" : segments);
+            ArrayNode arr = QaSupport.JSON.createArrayNode();
+            StringBuilder sb = new StringBuilder();
+            for (JsonNode s : segs) {
+                String doc = s.path("doc").asText(s.path("book").asText("?"));
+                String text = s.path("text").asText("");
+                String summary = summarizeOne(doc, text);
+                ObjectNode o = QaSupport.JSON.createObjectNode();
+                o.put("i", s.path("i").asInt());
+                o.put("doc", doc);
+                o.put("summary", summary);
+                arr.add(o);
+                sb.append("【").append(doc).append("】\n").append(summary).append("\n\n");
+            }
+            bookSummaries = arr.toString();
+            digest = sb.toString();
+        } catch (Exception e) {
+            bookSummaries = QaSupport.errorJson(e);
+        }
+        FlowEngine.instance().register("bookSummaries", bookSummaries);
+        FlowEngine.instance().register("digest", digest);
+    }
+
+    private String summarizeOne(String doc, String text) {
+        if (text == null || text.isEmpty()) {
+            return "";
+        }
+        StringBuilder sb = new StringBuilder();
+        int len = text.length();
+        int chunkCount = (len + CHUNK - 1) / CHUNK;
+        int i = 0;
+        int idx = 0;
+        while (i < len) {
+            int end = Math.min(len, i + CHUNK);
+            if (end < len) {
+                int k = text.lastIndexOf("\n\n", end);
+                if (k > i + CHUNK / 2) {
+                    end = k;
+                }
+            }
+            String part = text.substring(i, end);
+            idx++;
+            String t = callWithRetry(doc, idx, chunkCount, part);
+            sb.append("[第").append(idx).append("/").append(chunkCount).append("部分] ")
+                    .append(t).append("\n\n");
+            i = end;
+        }
+        return sb.toString();
+    }
+
+    private String callWithRetry(String doc, int idx, int total, String part) {
+        String user = "这是《" + doc + "》的第 " + idx + "/" + total + " 部分正文：\n\n" + part;
+        for (int attempt = 1; attempt <= 3; attempt++) {
+            try {
+                return QaSupport.callLlm(SUMSYS, user, 1200);
+            } catch (Exception e) {
+                if (attempt == 3) {
+                    return "[摘要失败：" + e.getMessage() + "]";
+                }
+                try {
+                    Thread.sleep(6000L * attempt);
+                } catch (InterruptedException ignored) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+        }
+        return "";
+    }
+}
