{
  "id": "@com.horsecoder.common.whuTalent.flowTesting.core/FLOW_QA_STREAM",
  "name": "FLOW_QA_STREAM",
  "type": "flow",
  "title": "超窗题通用底座：顺序分段读完后单选裁决",
  "params": [
    { "title": "题号", "name": "qid", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "收敛阈值（0 表示不收敛）", "name": "idleLimit", "type": "String", "scope": "defaultScope" }
  ],
  "results": [
    { "title": "答案", "name": "answer", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "是否正确", "name": "correct", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "裁决理由", "name": "verdict", "type": "String", "scope": "defaultScope" },
    { "title": "滚动笔记", "name": "memo", "type": "String", "scope": "defaultScope" },
    { "title": "读段情况", "name": "segInfo", "type": "String", "scope": "defaultScope" }
  ],
  "nodes": [
    {
      "id": "SPLIT",
      "type": "event",
      "title": "按窗口长度顺序切段",
      "reference": "FLOW_QA_SPLIT_CHUNKS",
      "params": [
        { "name": "qid", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "answerKey", "type": "String", "scope": "defaultScope" },
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "STREAM",
      "type": "event",
      "title": "逐段读并滚动更新笔记",
      "reference": "FLOW_QA_STREAM_READ",
      "params": [
        { "name": "segments", "type": "String", "scope": "defaultScope" },
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "idleLimit", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "memo", "type": "String", "scope": "defaultScope" },
        { "name": "segCount", "type": "String", "scope": "defaultScope" },
        { "name": "segInfo", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "DECIDE",
      "type": "event",
      "title": "按笔记做单选裁决",
      "reference": "FLOW_QA_DECIDE_MEMO",
      "params": [
        { "name": "memo", "type": "String", "scope": "defaultScope" },
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "answerKey", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "answer", "type": "String", "scope": "defaultScope" },
        { "name": "correct", "type": "String", "scope": "defaultScope" }
      ]
    }
  ],
  "routes": [
    { "source": "start", "target": "SPLIT", "condition": "true" },
    { "source": "SPLIT", "target": "STREAM", "condition": "true" },
    { "source": "STREAM", "target": "DECIDE", "condition": "true" },
    { "source": "DECIDE", "target": "end", "condition": "true" }
  ]
}
