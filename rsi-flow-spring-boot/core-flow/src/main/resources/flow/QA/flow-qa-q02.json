{
  "id": "@com.horsecoder.common.whuTalent.flowTesting.core/FLOW_QA_Q02",
  "name": "FLOW_QA_Q02",
  "type": "flow",
  "title": "Q02 多文档摘要后裁决",
  "params": [
    { "title": "题号", "name": "qid", "type": "String", "scope": "defaultScope", "notnull": true }
  ],
  "results": [
    { "title": "答案", "name": "answer", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "是否正确", "name": "correct", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "裁决理由", "name": "verdict", "type": "String", "scope": "defaultScope" },
    { "title": "文档摘要", "name": "bookSummaries", "type": "String", "scope": "defaultScope" }
  ],
  "nodes": [
    {
      "id": "Q02_SPLIT",
      "type": "event",
      "title": "按文档分册切段",
      "reference": "FLOW_QA_SPLIT_DOCS",
      "params": [
        { "name": "qid", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "answerKey", "type": "String", "scope": "defaultScope" },
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q02_SUMMARIZE",
      "type": "event",
      "title": "逐份文档结构化摘要",
      "reference": "FLOW_QA_SUMMARIZE",
      "params": [
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "bookSummaries", "type": "String", "scope": "defaultScope" },
        { "name": "digest", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q02_HYPOTHESIZE",
      "type": "event",
      "title": "选项压成可证伪命题",
      "reference": "FLOW_QA_HYPOTHESIZE_LITERAL",
      "params": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "propositions", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q02_GATHER",
      "type": "event",
      "title": "按命题回原文取证",
      "reference": "FLOW_QA_GATHER_STATS",
      "params": [
        { "name": "propositions", "type": "String", "scope": "defaultScope" },
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "evidence", "type": "String", "scope": "defaultScope" },
        { "name": "statsTable", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q02_FUSE",
      "type": "event",
      "title": "摘要与证据合成",
      "reference": "FLOW_QA_FUSE",
      "params": [
        { "name": "evidence", "type": "String", "scope": "defaultScope" },
        { "name": "digest", "type": "String", "scope": "defaultScope" },
        { "name": "statsTable", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "evidence", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q02_DECIDE",
      "type": "event",
      "title": "裁决与判分",
      "reference": "FLOW_QA_DECIDE_SCOPED",
      "params": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "evidence", "type": "String", "scope": "defaultScope" },
        { "name": "answerKey", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "answer", "type": "String", "scope": "defaultScope" },
        { "name": "correct", "type": "String", "scope": "defaultScope" }
      ]
    }
  ],
  "routes": [
    { "source": "start", "target": "Q02_SPLIT", "condition": "true" },
    { "source": "Q02_SPLIT", "target": "Q02_SUMMARIZE", "condition": "true" },
    { "source": "Q02_SUMMARIZE", "target": "Q02_HYPOTHESIZE", "condition": "true" },
    { "source": "Q02_HYPOTHESIZE", "target": "Q02_GATHER", "condition": "true" },
    { "source": "Q02_GATHER", "target": "Q02_FUSE", "condition": "true" },
    { "source": "Q02_FUSE", "target": "Q02_DECIDE", "condition": "true" },
    { "source": "Q02_DECIDE", "target": "end", "condition": "true" }
  ]
}
