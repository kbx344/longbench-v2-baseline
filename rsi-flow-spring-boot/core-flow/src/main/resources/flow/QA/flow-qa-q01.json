{
  "id": "@com.horsecoder.common.whuTalent.flowTesting.core/FLOW_QA_Q01",
  "name": "FLOW_QA_Q01",
  "type": "flow",
  "title": "Q01 定位失败转选项",
  "params": [
    { "title": "题号", "name": "qid", "type": "String", "scope": "defaultScope", "notnull": true }
  ],
  "results": [
    { "title": "答案", "name": "answer", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "是否正确", "name": "correct", "type": "String", "scope": "defaultScope", "notnull": true },
    { "title": "定位报告", "name": "locateReport", "type": "String", "scope": "defaultScope" },
    { "title": "裁决理由", "name": "verdict", "type": "String", "scope": "defaultScope" }
  ],
  "nodes": [
    {
      "id": "Q01_SPLIT",
      "type": "event",
      "title": "载入并切段",
      "reference": "FLOW_QA_SPLIT",
      "params": [
        { "name": "qid", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "answerKey", "type": "String", "scope": "defaultScope" },
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q01_LOCATE",
      "type": "event",
      "title": "实体定位尝试",
      "reference": "FLOW_QA_LOCATE",
      "params": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "locateReport", "type": "String", "scope": "defaultScope" },
        { "name": "usable", "type": "String", "scope": "defaultScope" },
        { "name": "propositions", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q01_HYPOTHESIZE",
      "type": "event",
      "title": "选项压成命题",
      "reference": "FLOW_QA_HYPOTHESIZE",
      "params": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "propositions", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q01_GATHER",
      "type": "event",
      "title": "分区取证",
      "reference": "FLOW_QA_GATHER",
      "params": [
        { "name": "propositions", "type": "String", "scope": "defaultScope" },
        { "name": "segments", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "evidence", "type": "String", "scope": "defaultScope" }
      ]
    },
    {
      "id": "Q01_DECIDE",
      "type": "event",
      "title": "裁决与判分",
      "reference": "FLOW_QA_DECIDE",
      "params": [
        { "name": "question", "type": "String", "scope": "defaultScope" },
        { "name": "choices", "type": "String", "scope": "defaultScope" },
        { "name": "evidence", "type": "String", "scope": "defaultScope" },
        { "name": "answerKey", "type": "String", "scope": "defaultScope" }
      ],
      "results": [
        { "name": "answer", "type": "String", "scope": "defaultScope" },
        { "name": "correct", "type": "String", "scope": "defaultScope" }
      ]
    }
  ],
  "routes": [
    { "source": "start", "target": "Q01_SPLIT", "condition": "true" },
    { "source": "Q01_SPLIT", "target": "Q01_LOCATE", "condition": "true" },
    { "source": "Q01_LOCATE", "target": "Q01_GATHER", "condition": "usable == 'true'" },
    { "source": "Q01_LOCATE", "target": "Q01_HYPOTHESIZE", "condition": "usable == 'false'" },
    { "source": "Q01_HYPOTHESIZE", "target": "Q01_GATHER", "condition": "true" },
    { "source": "Q01_GATHER", "target": "Q01_DECIDE", "condition": "true" },
    { "source": "Q01_DECIDE", "target": "end", "condition": "true" }
  ]
}
